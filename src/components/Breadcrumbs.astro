---
interface Props {
  items: { label: string, href?: string }[]
}
const { items } = Astro.props
---
<nav aria-label="Breadcrumb" class="breadcrumbs">
  <ol>
    {items.map(({ label, href }, i) => (
      <li>
        {href && i < items.length - 1
          ? <a href={href}>{label}</a>
          : <span aria-current="page">{label}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs { font-size: 0.875rem; margin-block: 24px 8px; }
  ol { display: flex; flex-wrap: wrap; list-style: none; padding: 0; margin: 0; color: var(--muted); }
  li + li::before { content: '/'; padding-inline: 0.5em; color: var(--line); }
  a { color: var(--ink-soft); text-decoration: none; }
  a:hover { color: var(--blue); text-decoration: underline; }
  span { color: var(--muted); }
</style>
