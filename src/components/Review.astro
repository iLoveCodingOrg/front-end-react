---
export interface ReviewData {
  title?: string
  body: string
  thumbSrc?: string
  credit1?: string
  credit2?: string
}
interface Props {
  review: ReviewData
  class?: string
}
const { review, class: className } = Astro.props
const { title, body, thumbSrc, credit1, credit2 } = review
const photo = thumbSrc?.startsWith('//') ? `https:${thumbSrc}` : thumbSrc
---
<figure class:list={['review', className]}>
  {title && <p class="review-title">{title}</p>}
  <blockquote>“{body}”</blockquote>
  <figcaption>
    {photo && <img src={photo} alt="" width="48" height="48" loading="lazy" />}
    <span>
      <strong>{credit1}</strong>
      {credit2 && <span class="where">{credit2}</span>}
    </span>
  </figcaption>
</figure>

<style>
  .review {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .review-title { font-weight: 700; font-size: 1.05rem; margin: 0; }
  blockquote { margin: 0; color: var(--ink-soft); font-style: italic; flex: 1; }
  figcaption { display: flex; align-items: center; gap: 12px; font-size: 0.9rem; }
  figcaption img { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; flex: none; }
  .where { display: block; color: var(--muted); }
</style>
