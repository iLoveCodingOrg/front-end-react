---
interface Props {
  title: string
  subTitle?: string
}
const { title, subTitle } = Astro.props
---
<header class="view-header">
  <h1>{title}</h1>
  {subTitle && <p class="lead">{subTitle}</p>}
  <slot />
</header>

<style>
  .view-header { margin-block: 8px 28px; }
  h1 { font-size: clamp(1.75rem, 4vw, 2.5rem); }
  .lead { margin-bottom: 0.75em; }
</style>
