---
interface Props {
  class?: string
}
const { class: className } = Astro.props
---
<aside class:list={['cta', className]}>
  <p class="cta-title">Become a confident software developer, for free.</p>
  <p class="cta-body">Follow the step-by-step curriculum from your first web page to full-stack JavaScript.</p>
  <a href="/curriculum" class="btn btn-primary">See the full curriculum</a>
</aside>

<style>
  .cta {
    text-align: center;
    border-radius: var(--radius);
    padding: clamp(24px, 4vw, 40px);
    background: var(--blue-tint);
    border: 1px solid color-mix(in srgb, var(--blue) 15%, transparent);
    margin-block: 48px;
  }
  .cta-title { font-size: 1.35rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.25em; }
  .cta-body { color: var(--ink-soft); margin-bottom: 1.25em; }
</style>
