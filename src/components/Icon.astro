---
interface Props {
  name: 'check' | 'x'
  size?: number
  label?: string
}
const { name, size = 18, label } = Astro.props
---
<svg
  width={size}
  height={size}
  viewBox="0 0 20 20"
  class={`icon icon-${name}`}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {name === 'check' && (
    <>
      <circle cx="10" cy="10" r="10" fill="var(--teal)" />
      <path d="M5.8 10.3l2.7 2.7 5.7-5.9" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}
  {name === 'x' && (
    <>
      <circle cx="10" cy="10" r="10" fill="var(--red)" />
      <path d="M6.8 6.8l6.4 6.4M13.2 6.8l-6.4 6.4" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" />
    </>
  )}
</svg>
