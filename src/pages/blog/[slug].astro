---
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import Cta from '../../components/Cta.astro'
import ViewHeader from '../../components/ViewHeader.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import '../../styles/prose.css'
import { type Post, blogs, formatDate, stripHtml } from '../../lib/content'

export function getStaticPaths() {
  return blogs.map(post => ({ params: { slug: post.slug }, props: { post } }))
}

const { post } = Astro.props as { post: Post }
const description = post.subTitle || stripHtml(post.bodyContent).slice(0, 160)
---
<BaseLayout title={post.title} description={description}>
  <article class="container-slim">
    <Breadcrumbs items={[{ label: 'Blog', href: '/blog' }, { label: post.title }]} />
    <ViewHeader title={post.title} subTitle={post.subTitle}>
      {post.date && <p class="byline">By Aziz Ali · <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time></p>}
    </ViewHeader>
    <div class="prose prose-serif" set:html={post.bodyContent} />
    <Cta />
  </article>
</BaseLayout>

<style>
  .byline { color: var(--muted); font-size: 0.9rem; margin: 0; }
</style>
