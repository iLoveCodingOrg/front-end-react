---
import BaseLayout from '../layouts/BaseLayout.astro'
---
<BaseLayout title="Page not found" noindex>
  <div class="container-slim not-found">
    <p class="code">404</p>
    <h1>Page not found</h1>
    <p class="lead">Oops, you landed out of the internet! The page you are looking for does not exist.</p>
    <div class="actions">
      <a href="/" class="btn btn-primary">Go to the home page</a>
      <a href="/courses" class="btn btn-outline">Browse courses</a>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found { text-align: center; padding-block: var(--section); }
  .code { font-size: 5rem; font-weight: 800; color: var(--blue); line-height: 1; margin-bottom: 0.2em; letter-spacing: -0.04em; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 24px; }
</style>
