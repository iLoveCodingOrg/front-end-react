---
import BaseLayout from '../layouts/BaseLayout.astro'
import { courses } from '../lib/content'
---
<BaseLayout title="All Lessons" description="Every iLoveCoding video lesson, grouped by course.">
  <div class="container-slim">
    <header class="page-header">
      <h1>All Lessons</h1>
      <p class="lead">Individual lessons, grouped by the course they belong to.</p>
    </header>
    {courses.map(course => (
      <section>
        <h2><a href={`/courses/${course.slug}`}>{course.title}</a></h2>
        <ol>
          {course.lesson.map(lesson => (
            <li><a href={`/courses/${course.slug}/lessons/${lesson.slug}`}>{lesson.title}</a></li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  section { padding-block: 24px; border-top: 1px solid var(--line); }
  section:last-child { margin-bottom: var(--section); }
  h2 { font-size: 1.3rem; }
  h2 a { color: var(--ink); text-decoration: none; }
  h2 a:hover { color: var(--blue); }
  ol { columns: 2 280px; column-gap: 32px; }
  li { break-inside: avoid; margin-bottom: 0.3em; }
</style>
